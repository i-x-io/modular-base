<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ModularBase.Build</RootNamespace>
    <NukeTelemetryVersion>1</NukeTelemetryVersion>
    <!-- NUKE conventionally names its executable _build. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nuke.Common" />
    <PackageReference Include="Octokit" PrivateAssets="all" />
    <!--
      NUKE 10.1.0 resolves vulnerable transitive versions as of 2026-07-28.
      Keep these build-private floor overrides until NUKE adopts patched versions.
    -->
    <PackageReference Include="NuGet.Packaging" PrivateAssets="all" />
    <PackageReference Include="NuGet.Versioning" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.Xml" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ModularBase.Build.Tests" />
  </ItemGroup>
</Project>
